{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opncafyr/recipe-v1",
  "title": "Cleaning and mapping recipe (.opncafyr/recipes/<id>.yaml)",
  "description": "Ordered, explicit cleaning steps for one imported source (#22). The source file is never rewritten; a row leaves the data only through a filter_rows step with a reason, and lands in the rejected-row log. Steps carry data, never code: the launcher compiles them to a fixed R program. Semantic rules the schema cannot express (new-column targets, no numeric zero for BLQ values, column existence) are checked by workflows/nca/recipe.py. The optional mapping block (#23) names the column for each role, the units and the value tables of the flag columns; the user confirms every entry. The optional events block (#58, schema_version 1.1) describes NONMEM-style event records: which columns hold the subject, time, record kind, amount, endpoint and route, what each record-kind, endpoint and MDV code means, and the user's choices for ambiguous dosing cases. The launcher turns it into a fixed R stage after the steps; nothing in it is code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_id",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "1.1 exactly when the recipe has an events block (#58); 1.0 recipes are unchanged."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "steps": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "mapping": {
      "$ref": "#/$defs/mapping"
    },
    "events": {
      "$ref": "#/$defs/events"
    }
  },
  "$defs": {
    "column": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "value": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^[^\\u0000]*$"
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "where": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "equals"
          ],
          "properties": {
            "column": {
              "$ref": "#/$defs/column"
            },
            "equals": {
              "$ref": "#/$defs/value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "in"
          ],
          "properties": {
            "column": {
              "$ref": "#/$defs/column"
            },
            "in": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5000,
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "is_blank"
          ],
          "properties": {
            "column": {
              "$ref": "#/$defs/column"
            },
            "is_blank": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/where"
              }
            }
          }
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "clean_names"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "rename"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "$ref": "#/$defs/column"
                },
                "to": {
                  "$ref": "#/$defs/column"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "trim"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "columns"
              ],
              "properties": {
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/column"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "parse_type"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "column",
                "type",
                "decimal_mark"
              ],
              "properties": {
                "column": {
                  "$ref": "#/$defs/column"
                },
                "type": {
                  "enum": [
                    "number",
                    "integer"
                  ]
                },
                "decimal_mark": {
                  "enum": [
                    ".",
                    ","
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "recode"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "column",
                "map"
              ],
              "properties": {
                "column": {
                  "$ref": "#/$defs/column"
                },
                "map": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 500,
                  "propertyNames": {
                    "$ref": "#/$defs/value"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/value"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "derive"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "target",
                    "fn",
                    "from"
                  ],
                  "properties": {
                    "target": {
                      "$ref": "#/$defs/column"
                    },
                    "fn": {
                      "const": "copy"
                    },
                    "from": {
                      "$ref": "#/$defs/column"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "target",
                    "fn",
                    "from",
                    "sep"
                  ],
                  "properties": {
                    "target": {
                      "$ref": "#/$defs/column"
                    },
                    "fn": {
                      "const": "concat"
                    },
                    "from": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "$ref": "#/$defs/column"
                      }
                    },
                    "sep": {
                      "$ref": "#/$defs/value"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "target",
                    "fn",
                    "value"
                  ],
                  "properties": {
                    "target": {
                      "$ref": "#/$defs/column"
                    },
                    "fn": {
                      "const": "constant"
                    },
                    "value": {
                      "$ref": "#/$defs/value"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "derive_elapsed_time"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "from",
                "reference",
                "unit",
                "time_zone"
              ],
              "properties": {
                "target": {
                  "$ref": "#/$defs/column"
                },
                "from": {
                  "$ref": "#/$defs/column"
                },
                "reference": {
                  "$ref": "#/$defs/column"
                },
                "unit": {
                  "enum": [
                    "s",
                    "min",
                    "h",
                    "d",
                    "w"
                  ]
                },
                "time_zone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "How time zones were handled, in words; recorded, not interpreted."
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "convert_units"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value_column",
                "unit_column",
                "from",
                "to"
              ],
              "properties": {
                "value_column": {
                  "$ref": "#/$defs/column"
                },
                "unit_column": {
                  "$ref": "#/$defs/column"
                },
                "from": {
                  "$ref": "#/$defs/value"
                },
                "to": {
                  "$ref": "#/$defs/value"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "flag"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "column",
                "table"
              ],
              "properties": {
                "target": {
                  "$ref": "#/$defs/column"
                },
                "column": {
                  "$ref": "#/$defs/column"
                },
                "table": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 200,
                  "propertyNames": {
                    "$ref": "#/$defs/value"
                  },
                  "additionalProperties": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "exclude"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "where",
                "reason"
              ],
              "properties": {
                "where": {
                  "$ref": "#/$defs/where"
                },
                "reason": {
                  "$ref": "#/$defs/reason"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "filter_rows"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "where",
                "reason"
              ],
              "properties": {
                "where": {
                  "$ref": "#/$defs/where"
                },
                "reason": {
                  "$ref": "#/$defs/reason"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "report_dupes"
            },
            "note": {
              "$ref": "#/$defs/note"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "columns"
              ],
              "properties": {
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/column"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles"
      ],
      "properties": {
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "SUBJECT_ID": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "SECONDARY_ID": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ANALYTE": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ANALYTE_LABEL": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "SPECIMEN": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ACTUAL_TIME": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "NOMINAL_TIME": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "CONC": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "CONC_UNIT": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "LLOQ": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "BLQ": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "MISSING": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "EXCLUDED": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "EXCLUSION_REASON": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "DOSE": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "DOSE_UNIT": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ROUTE": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "TAU": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "INFUSION_DURATION": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            },
            "OCCASION": {
              "oneOf": [
                {
                  "$ref": "#/$defs/column"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ACTUAL_TIME": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "column"
                  ],
                  "properties": {
                    "column": {
                      "$ref": "#/$defs/column"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  }
                }
              ]
            },
            "CONC": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "column"
                  ],
                  "properties": {
                    "column": {
                      "$ref": "#/$defs/column"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  }
                }
              ]
            },
            "DOSE": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "column"
                  ],
                  "properties": {
                    "column": {
                      "$ref": "#/$defs/column"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  }
                }
              ]
            }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "BLQ": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "table": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 200,
                  "propertyNames": {
                    "$ref": "#/$defs/value"
                  },
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                "text_pattern": {
                  "enum": [
                    "^<"
                  ],
                  "description": "Also BLQ: concentration text starting with '<' (ADR 0005 Q3)."
                }
              }
            },
            "MISSING": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "table"
              ],
              "properties": {
                "table": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 200,
                  "propertyNames": {
                    "$ref": "#/$defs/value"
                  },
                  "additionalProperties": {
                    "type": "boolean"
                  }
                }
              }
            },
            "EXCLUDED": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "table"
              ],
              "properties": {
                "table": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 200,
                  "propertyNames": {
                    "$ref": "#/$defs/value"
                  },
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                "reason": {
                  "$ref": "#/$defs/reason",
                  "description": "One reason for every excluded row, when there is no reason column."
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "record_kinds",
        "endpoints"
      ],
      "description": "Event-record preparation (#58, ADR 0005 Q9). Every record lands in exactly one partition; only selected PK observations go on to mapping and checks.",
      "properties": {
        "columns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "time",
            "record_kind",
            "amount",
            "endpoint",
            "route"
          ],
          "description": "Columns after the cleaning steps. route, dose_unit are read on dose records; dv, mdv, occasion and time_unit are optional.",
          "properties": {
            "subject": {
              "$ref": "#/$defs/column"
            },
            "time": {
              "$ref": "#/$defs/column"
            },
            "record_kind": {
              "$ref": "#/$defs/column"
            },
            "amount": {
              "$ref": "#/$defs/column"
            },
            "endpoint": {
              "$ref": "#/$defs/column"
            },
            "route": {
              "$ref": "#/$defs/column"
            },
            "dv": {
              "$ref": "#/$defs/column"
            },
            "mdv": {
              "$ref": "#/$defs/column"
            },
            "occasion": {
              "$ref": "#/$defs/column"
            },
            "dose_unit": {
              "$ref": "#/$defs/column"
            },
            "time_unit": {
              "$ref": "#/$defs/column"
            }
          }
        },
        "record_kinds": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "propertyNames": {
            "$ref": "#/$defs/value"
          },
          "additionalProperties": {
            "enum": [
              "observation",
              "dose",
              "other"
            ]
          },
          "description": "Every value of the record-kind column (such as EVID) and what it means. A value not listed is unresolved."
        },
        "endpoints": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 200,
          "propertyNames": {
            "$ref": "#/$defs/value"
          },
          "additionalProperties": {
            "enum": [
              "pk",
              "other"
            ]
          },
          "description": "Every endpoint value (such as CMT or DVID) seen on observation records: a PK analyte or another endpoint. A dose record's endpoint is never an analyte."
        },
        "mdv": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 20,
          "propertyNames": {
            "$ref": "#/$defs/value"
          },
          "additionalProperties": {
            "type": "boolean"
          },
