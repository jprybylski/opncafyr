{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opncafyr/tutorial-v1",
  "title": "Tutorial",
  "description": "A walkthrough of the app's screens (#69, ADR 0010): ordered steps of plain text, each optionally pointing at a control (a guidance target), opening a view, or waiting for a read-only condition. Data only: no HTML, script, URL, endpoint, path or command. The tutorial never acts for the user.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "steps"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/name" },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,31}$" },
    "title": { "$ref": "#/$defs/line" },
    "audience": { "$ref": "#/$defs/line" },
    "prerequisites": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/line" }
    },
    "profile": {
      "$ref": "#/$defs/name",
      "description": "The id of a study profile this tutorial goes with. Shown only; it changes nothing."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "text"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "title": { "$ref": "#/$defs/line" },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "view": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "description": "A view of the app to show for this step, such as analysis."
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$",
            "description": "The control or card to highlight (GET /api/guidance)."
          },
          "wait_for": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$",
            "description": "A condition that must hold before Next is enabled; Skip always works."
          }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "line": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]*$" }
  }
}
