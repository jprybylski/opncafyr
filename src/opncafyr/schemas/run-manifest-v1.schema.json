{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opncafyr/run-manifest-v1",
  "title": "Analysis run manifest (.opncafyr/runs/<run-id>/manifest.json)",
  "description": "One analyte per run (#26). Written atomically and validated on every read and write (core/runs.py). Holds hashes and settings, never row data. A completed run is sealed: every file is listed with its SHA-256 and made read-only; any change makes a new run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "state",
    "source",
    "recipe",
    "analysis_input",
    "analyte",
    "mapping",
    "units",
    "tools"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact_column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifact_replay": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reproduced",
            "file"
          ],
          "properties": {
            "reproduced": {
              "const": true
            },
            "file": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reproduced",
            "reason"
          ],
          "properties": {
            "reproduced": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4,}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "reviewing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "description": "The cleaning recipe and mapping the input came from (recipe-v1, canonical JSON hash).",
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_sha256",
        "steps_sha256"
      ],
      "properties": {
        "recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "steps_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parent_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "analysis_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "rows"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "analyte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "value"
      ],
      "properties": {
        "column": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "description": "Exact raw value used for the filter."
        },
        "label": {
          "type": "string"
        }
      }
    },
    "specimen": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "column",
        "value"
      ],
      "properties": {
        "column": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "description": "Exact raw value used for the specimen filter."
        }
      }
    },
    "mapping": {
      "type": "object",
      "description": "The recipe's mapping block: role -> column, units, flag value tables."
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "description": "Units as declared in the mapping (ADR 0005 Q2): a unit column or one value per role. The labels opnca-r was given are `analysis_units`.",
      "properties": {
        "ACTUAL_TIME": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "minProperties": 1,
          "maxProperties": 1
        },
        "CONC": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "minProperties": 1,
          "maxProperties": 1
        },
        "DOSE": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "minProperties": 1,
          "maxProperties": 1
        }
      }
    },
    "analysis_units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concentration",
        "time",
        "dose"
      ],
      "description": "The unit labels of the frozen analysis input, passed to opnca-r as its preset `units` (opnca-r 0.3.1, #57): each role's declared unit, or the one unit its unit column holds across the selected rows, in the launcher's spelling (units.normalise). Labels only: values are scaled only by a recorded 'Convert units' step. Absent on runs made before 0.3.1 was pinned.",
      "properties": {
        "concentration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "dose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "settings": {
      "$ref": "#/$defs/file"
    },
    "row_accounting": {
      "type": "object",
      "description": "Rows from the source to the snapshot.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "acknowledgements": {
      "type": "array",
      "description": "Warnings the user acknowledged before the run (ADR 0005 Q7).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "check",
          "acknowledged_at"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "acknowledged_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "nca_settings": {
      "type": "object",
      "description": "The BLQ choices made at the start and, once saved, opnca-r's settings and effective settings from its analysis record."
    },
    "exclusions": {
      "type": "object",
      "description": "Exclusions: launcher rows (with reasons) and in-session opnca-r exclusions (no reason recorded)."
    },
    "tools": {
      "type": "object",
      "description": "Versions of the launcher, opnca-r and R that made the run.",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "opncafyr"
      ]
    },
    "script": {
      "$ref": "#/$defs/file"
    },
    "record": {
      "$ref": "#/$defs/file",
      "description": "opnca-r's analysis-record.json."
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saved_at",
        "artifacts_sha256"
      ],
      "description": "opnca-r's server-side save: COMPLETE's time and the SHA-256 of its artifacts.json.",
      "properties": {
        "saved_at": {
          "type": "string"
        },
        "artifacts_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "description": "A saved file. path, sha256, kind, media_type and bytes come from the launcher's check of the save. The other fields are optional: they are what opnca-r's artifacts.json schema 2 (opnca-r 0.3.0+, identifies_subjects since 0.3.1) says the file is, copied as written (#59), and a run saved by an earlier opnca-r has none of them.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind",
          "media_type"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "kind": {
            "enum": [
              "table",
              "figure",
              "record",
              "script",
              "log",
              "input",
              "settings",
              "other"
            ]
          },
          "media_type": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string"
          },
          "analysis": {
            "type": "string"
          },
          "grouping_view": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject_level": {
            "type": "boolean"
          },
          "identifies_subjects": {
            "type": "boolean",
            "description": "Whether the saved file itself shows subject or profile identifiers (opnca-r#58). The curator's contains_subject_ids."
          },
          "settings": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON pointer into the analysis record."
          },
          "replay": {
            "$ref": "#/$defs/artifact_replay"
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact_column"
            }
          },
          "caption": {
            "type": [
              "string",
              "null"
            ]
          },
          "footnote": {
            "type": [
              "string",
              "null"
            ]
          },
          "table": {
            "type": [
              "string",
              "null"
            ]
          },
          "derived_from": {
            "type": "string"
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rtol",
        "path",
        "sha256",
        "at"
      ],
      "description": "Replay of analysis.R compared with the saved results (#29).",
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "rtol": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Warnings raised after the start, such as in-session exclusions without a reason."
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "message",
        "at"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sealed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "files"
      ],
      "description": "Every file of the completed run except manifest.json, with its hash. The run is read-only from then on.",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "reviewing",
              "completed"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "script",
          "record",
          "export",
          "artifacts",
          "nca_settings"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "replay",
          "sealed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "failure"
        ]
      }
    }
  ]
}
