{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opncafyr/tool-descriptor-v1",
  "title": "Trusted tool descriptor",
  "description": "Shipped with an installed adapter. Never read from a study workspace. Executables are symbolic names looked up in the installed runtime record (runtime-v1), never paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "runtime", "capabilities", "executables", "health"],
  "$defs": {
    "executable_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "display_name": {"type": "string", "minLength": 1},
    "runtime": {"enum": ["python", "r", "binary"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "executables": {
      "description": "Runtime executables the tool cannot work without.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/executable_name"}
    },
    "health": {
      "description": "Startup probe. The launcher builds the command from kind and target; nothing here is run verbatim.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "executable"],
      "properties": {
        "kind": {"enum": ["python_import", "r_package", "version_flag"]},
        "executable": {"$ref": "#/$defs/executable_name"},
        "target": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "python_import"}}},
          "then": {
            "required": ["target"],
            "properties": {
              "target": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "r_package"}}},
          "then": {
            "required": ["target"],
            "properties": {"target": {"pattern": "^[A-Za-z][A-Za-z0-9.]*[A-Za-z0-9]$"}}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "version_flag"}}},
          "then": {"not": {"required": ["target"]}}
        }
      ]
    },
    "web_app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "readiness"],
      "properties": {
        "route": {"type": "string", "pattern": "^/apps/[a-z][a-z0-9_-]*/$"},
        "readiness": {"type": "string", "pattern": "^/"},
        "max_body_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "jobs": {
      "description": "Job contracts. A schema name is resolved in the adapter's own schemas/ folder, then among the launcher's schemas; a name found in both is an error. input_schema is optional (#55): a job whose input is not a JSON document has none.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_schema"],
        "properties": {
          "input_schema": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$"},
          "output_schema": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$"},
          "timeout_s": {"type": "integer", "minimum": 1}
        }
      }
    },
    "project_editor": {
      "description": "Opts the tool into the launcher's project-file editor (#52). Every value is a declarative id that the installed adapter bundles: never a path glob, command, module or executable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "project_root", "file_profile"],
      "properties": {
        "capability": {"$ref": "#/$defs/capability"},
        "project_root": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "file_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$"},
        "settings_schema": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$"}
      }
    },
    "optional_requirements": {
      "description": "Runtime executables that enable extra features. When one is missing the tool still works and the listed capabilities are reported unavailable.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "executable", "message"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "executable": {"$ref": "#/$defs/executable_name"},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
