{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opncafyr/settings-v1",
  "title": "Per-user launcher settings (app state dir)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "idle_timeout_minutes": {
      "type": ["integer", "null"],
      "minimum": 5,
      "maximum": 1440,
      "description": "Stop after this many idle minutes; null turns idle shutdown off. Default 30."
    }
  }
}
