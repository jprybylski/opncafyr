{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opncafyr/run-settings-v1",
  "title": "A run's analysis settings (.opncafyr/runs/<run-id>/settings.json)",
  "description": "Everything the user chose for one run (#25): the analyte and specimen values, the mapping and units, the BLQ rules and method, and the warnings acknowledged. Written once, read-only afterwards. Holds no row data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "recipe",
    "source",
    "analyte",
    "specimen",
    "mapping",
    "blq",
    "acknowledgements",
    "snapshot",
    "row_accounting"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "1.1 exactly for a run prepared from event records (#58), which has a preparation block."
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4,}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "steps_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "steps_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "analyte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "value",
        "label"
      ],
      "properties": {
        "column": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "specimen": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "column",
        "value"
      ],
      "properties": {
        "column": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "mapping": {
      "type": "object",
      "description": "The recipe's mapping block (recipe-v1 $defs/mapping)."
    },
    "analysis_units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concentration",
        "time",
        "dose"
      ],
      "description": "The unit labels of the frozen analysis input, passed to opnca-r as its preset `units` (opnca-r 0.3.1, #57): each role's declared unit, or the one unit its unit column holds across the selected rows, in the launcher's spelling (units.normalise). Labels only: values are scaled only by a recorded 'Convert units' step. Absent on runs made before 0.3.1 was pinned.",
      "properties": {
        "concentration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "dose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "blq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "method"
      ],
      "properties": {
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blq_predose",
            "blq_postdose",
            "blq_terminal"
          ],
          "properties": {
            "blq_predose": {
              "enum": [
                "exclude",
                "zero",
                "half-lloq",
                "lloq-over-sqrt2"
              ]
            },
            "blq_postdose": {
              "enum": [
                "exclude",
                "zero",
                "half-lloq",
                "lloq-over-sqrt2"
              ]
            },
            "blq_terminal": {
              "enum": [
                "exclude",
                "zero",
                "half-lloq",
                "lloq-over-sqrt2"
              ]
            }
          }
        },
        "method": {
          "enum": [
            "conventional",
            "censored_lognormal"
          ]
        }
      }
    },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "check",
          "acknowledged_at"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "acknowledged_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "rows",
        "columns"
      ],
      "properties": {
        "path": {
          "const": "input/analysis.csv"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "object",
          "description": "The columns the launcher added: role -> column name.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "row_accounting": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the analysis input was prepared from event records (#58, ADR 0005 Q9): the events block as saved, the partition of every source record, and the script that did it.",
      "required": [
        "kind",
        "events_sha256",
        "rules",
        "accounting",
        "records",
        "script"
      ],
      "properties": {
        "kind": {
          "const": "event_records"
        },
        "events_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rules": {
          "type": "object",
          "description": "The recipe's events block, verbatim (validated by recipe-v1)."
        },
        "accounting": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "records": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "description": "input/event-records.csv: line, partition, category and dose lines of every record; no data values."
        },
        "script": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "description": "input/prepare.R: the generated cleaning and event script that made the input."
        }
      }
    }
  },
  "if": {
    "properties": {
      "schema_version": {
        "const": "1.1"
      }
    },
    "required": [
      "schema_version"
    ]
  },
  "then": {
    "required": [
      "preparation"
    ]
  },
  "else": {
    "not": {
      "required": [
        "preparation"
      ]
    }
  }
}
