{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opncafyr/replay-v1",
  "title": "Replay check of a saved run (.opncafyr/runs/<run-id>/logs/replay-<n>/replay.json)",
  "description": "analysis.R re-run on the run's input in a copy of the run, its tables compared with the saved results (#29). Identifiers, counts and status must be equal; other numbers agree within rtol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "at",
    "rtol",
    "status",
    "tables",
    "differences",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "rtol": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "problem": {
      "type": [
        "string",
        "null"
      ]
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "ok",
          "mismatches",
          "mismatch_count",
          "max_rel_diff"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "rows": {
            "type": "integer"
          },
          "replayed_rows": {
            "type": "integer"
          },
          "problem": {
            "type": "string"
          },
          "columns": {
            "type": "object"
          },
          "mismatches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "row",
                "column",
                "saved",
                "replayed",
                "rel_diff"
              ],
              "properties": {
                "row": {
                  "type": "integer"
                },
                "column": {
                  "type": "string"
                },
                "saved": {
                  "type": "string"
                },
                "replayed": {
                  "type": "string"
                },
                "rel_diff": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "mismatch_count": {
            "type": "integer",
            "minimum": 0
          },
          "max_rel_diff": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "not_reproduced": {
      "type": "array",
      "description": "Saved tables that analysis.R does not replay, as opnca-r's artifacts.json states (replay.reproduced false, schema 2), with its reason. They are not compared. Absent in reports written before opnca-r 0.3.1 was pinned.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "reason"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "differences": {
      "type": "string"
    },
    "script_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
