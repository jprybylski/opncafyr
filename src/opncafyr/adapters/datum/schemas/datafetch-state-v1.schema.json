{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datafetch-state-v1",
  "title": "External data state (.opncafyr/datafetch/state.json)",
  "description": "The launcher's own record for datum-managed external data (#83): the last check and, per dataset, the bytes the last Apply put in the study. Ids, paths, fingerprints and hashes only; never a data value or a credential.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "last_check", "datasets"],
  "properties": {
    "schema_version": {"const": 1},
    "last_check": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "results"],
          "properties": {
            "at": {"type": "string"},
            "results": {"type": "array", "items": {"$ref": "#/$defs/result"}}
          }
        }
      ]
    },
    "datasets": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]{1,64}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fetched_at", "files"],
        "properties": {
          "fetched_at": {"type": "string"},
          "remote_fingerprint": {"type": ["string", "null"]},
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "size"],
              "properties": {
                "path": {"type": "string", "pattern": "^source-data/"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "size": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string"},
        "status": {"type": "string"},
        "message": {"type": "string"},
        "lock_fingerprint": {"type": "string"},
        "remote_fingerprint": {"type": "string"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
